#!/usr/bin/env bash
# Git commit-msg hook enforcing Conventional Commits specification

COMMIT_MSG_FILE="$1"

if [ ! -f "$COMMIT_MSG_FILE" ]; then
    echo "❌ ERROR: Commit message file not found: $COMMIT_MSG_FILE"
    exit 1
fi

# Extract the first non-comment line of the commit message
COMMIT_MSG=$(grep -v '^#' "$COMMIT_MSG_FILE" | grep -v '^[[:space:]]*$' | head -n 1)

if [ -z "$COMMIT_MSG" ]; then
    echo "❌ ERROR: Commit message cannot be empty."
    exit 1
fi

# Regex enforcing Conventional Commits 1.0.0 format:
# <type>(<scope>)?: <description>  or  <type>(<scope>)?!: <description>
CONVENTIONAL_REGEX='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_.-]+\))?!?: .+$'

if ! [[ "$COMMIT_MSG" =~ $CONVENTIONAL_REGEX ]]; then
    echo ""
    echo "❌ COMMIT REJECTED: Invalid commit message format."
    echo "   Received: \"$COMMIT_MSG\""
    echo ""
    echo "   Commit messages must follow Conventional Commits specification:"
    echo "   <type>(<scope>): <description>"
    echo ""
    echo "   Valid Examples:"
    echo "     feat(mesh): add outbound seed connection support"
    echo "     fix(relay): resolve reconnect backoff bug"
    echo "     test(mesh): add two-node sync test"
    echo "     chore: update build dependencies"
    echo ""
    echo "   Allowed types:"
    echo "     feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo ""
    exit 1
fi

echo "✔ Commit message meets Conventional Commits standard."
exit 0
